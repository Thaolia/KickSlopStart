#!/usr/bin/env bash
# Pre-push validation of the dev ROM, three Amiberry sessions in parallel (four with PP_IDE=1; replaces the FS-UAE
# runs):
#   pp512 / pp0 : assets/boot_c.adf with 512 KB / 0 KB of slow RAM -> "E3 CMD RAN OK", no FAIL line, marker list
#   pplem       : assets/lemmings_flt.adf (slow 512) -> waits for the FAIRLIGHT intro, left-clicks (again while the
#                 intro stays), waits up to 5 min for the game menu, screenshot to look at
#   ppide       : only with PP_IDE=1 (changes to IDE or the filesystem, releases): tests/ide_rdb_probe.sh on the A600
#                 profile (RDB partitions DOS\0-DOS\3 read and written, host checks), about 10 min, so it is not
#                 part of every push
# Usage (repository root): .claude/skills/amiberry/scripts/prepush-check [rom]   (default build/kick13.rom)
# Exit 0 when both serial runs pass, the Lemmings menu is detected and, with PP_IDE=1, ide_rdb_probe exits 0; still
# look at the Lemmings screenshot.
# PP_PREFIX (default "pp") names the sessions <prefix>512, <prefix>0, <prefix>lem, <prefix>ide: two runs at the same
# time (two Claude sessions) need different prefixes, or each stops the other's sessions.
set -u
cd "$(dirname "$0")/../../../.." || exit 2
A=.claude/skills/amiberry/scripts/amiberry-session
ROM="${1:-build/kick13.rom}"
SESS=build/amiberry/sessions
P="${PP_PREFIX:-pp}"
S512="${P}512" S0="${P}0" SLEM="${P}lem" SIDE="${P}ide"
MARKERS=("RAWDOFMT OK" "DOS LOCK EXAMINE OK" "M6U TRACKDISK READ OK" "D1 OFS READ OK" "D2LOADSEG OK"
  "CONSOLE WRITE OK" "REQUESTER DRAWN OK" "F1BOOTOK" "E3 CMD RAN OK" "M7A TIMER OK" "M7E IPL OK" "MATHFFP OK"
  "DISKRES OK" "POTGO OK" "KBDDEV OK" "AUDIO ALLOC OK" "AUDIO PLAY OK" "SEM OK" "SEM WAIT OK" "REGIONS OK"
  "LAYERS OK" "GAMEPORT OK" "KEYMAP OK")

t0=$(date +%s)
md5sum "$ROM"
$A stop "$S512" "$S0" "$SLEM" "$SIDE" >/dev/null 2>&1
rm -rf "${SESS:?}/$S512" "${SESS:?}/$S0" "${SESS:?}/$SLEM" "${SESS:?}/$SIDE"
ide_pid=
if [ "${PP_IDE:-0}" = 1 ]; then
  tests/ide_rdb_probe.sh "$ROM" "$SIDE" a600 1500 > "$SESS/$SIDE.result" 2>&1 &
  ide_pid=$!
fi
starts=()
$A start --name "$S512" --rom "$ROM" --adf assets/boot_c.adf --slow 512 >/dev/null & starts+=($!)
$A start --name "$S0" --rom "$ROM" --adf assets/boot_c.adf --slow 0 >/dev/null & starts+=($!)
$A start --name "$SLEM" --rom "$ROM" --adf assets/lemmings_flt.adf --slow 512 >/dev/null & starts+=($!)
wait "${starts[@]}"                             # not the ide_rdb_probe job, which runs to the end

# Screen state from an IPC capture: "intro" (FAIRLIGHT, dark blue #000033 background), "shell" (AmigaSlopDOS window
# shown while the game loads, #AA99CC), "menu" (the game's 32-colour title picture: 28 distinct colours in an IPC
# capture, against 3 for the intro and 4 for the shell), "other" (blank frames, transitions). Fixed delays failed
# under host load: a click before the intro accepts input is lost and the intro loops, and the game takes over a
# minute to load after the click.
lem_state() {
  $A shot "$SLEM" state.png --via ipc >/dev/null 2>&1 || { echo none; return; }
  local img="$SESS/$SLEM/state.png" top n
  top=$(convert "$img" -crop 600x460+76+40 +repage -format %c histogram:info:- | sort -rn | head -1)
  n=$(convert "$img" -crop 600x460+76+40 +repage -format %k info:)
  if [ "$n" -ge 16 ]; then echo menu
  elif [[ "$top" == *"#000033"* ]]; then echo intro
  elif [[ "$top" == *"#AA99CC"* ]]; then echo shell
  else echo other; fi
}

lemmings() {
  $A wait-serial "$SLEM" "M6Y STRAP BOOTED" 120 >/dev/null || { echo "$SLEM: disk not booted"; return 1; }
  local t st clicks=0 last=-20
  for ((t = 0; t < 120; t += 3)); do [ "$(lem_state)" = intro ] && break; sleep 3; done
  [ "$t" -ge 120 ] && { echo "$SLEM: intro not shown"; return 1; }
  sleep 5
  for ((t = 0; t < 300; t += 5)); do
    st=$(lem_state)
    [ "$st" = menu ] && break
    if [ "$st" = intro ] && [ $((t - last)) -ge 20 ] && [ "$clicks" -lt 4 ]; then
      printf 'click\n' | $A input "$SLEM" - >/dev/null
      clicks=$((clicks + 1)) last=$t
    fi
    sleep 5
  done
  sleep 3
  $A shot "$SLEM" lemmings.png --via ipc >/dev/null
  if [ "$st" = menu ]; then
    echo "$SLEM: game menu after ${t} s ($clicks click(s)), screenshot $SESS/$SLEM/lemmings.png"
  else
    echo "$SLEM: game menu not reached (state $st, $clicks click(s)), screenshot $SESS/$SLEM/lemmings.png"
    return 1
  fi
}
lemmings > "$SESS/$SLEM.result" 2>&1 &
lem_pid=$!

rc=0
for s in "$S512" "$S0"; do
  if $A wait-serial "$s" "E3 CMD RAN OK" 280 >/dev/null; then
    log="$SESS/$s/serial.log"
    missing=()
    for m in "${MARKERS[@]}"; do grep -aqF "$m" "$log" || missing+=("$m"); done
    failed=$(grep -ac FAIL "$log")
    echo "$s: $(grep -a 'MEM SLOW' "$log" | tr -d '\r') FAIL=$failed missing=[${missing[*]}]"
    [ "$failed" = 0 ] && [ ${#missing[@]} = 0 ] || rc=1
  else
    echo "$s: E3 CMD RAN OK not reached"; rc=1
  fi
  $A stop "$s" >/dev/null
done
wait "$lem_pid" || rc=1
cat "$SESS/$SLEM.result"
$A stop "$SLEM" >/dev/null
if [ -z "$ide_pid" ]; then
  echo "$SIDE: skipped (PP_IDE=1 runs tests/ide_rdb_probe.sh)"
elif wait "$ide_pid"; then
  echo "$SIDE: ide_rdb_probe OK ($(grep -c ': identical' "$SESS/$SIDE.result") files identical), log $SESS/$SIDE.result"
else
  echo "$SIDE: ide_rdb_probe FAILED, log $SESS/$SIDE.result"
  grep -E 'FAIL:|DIFFERS|still present|entries, 79|OFS CHECK FAIL|xdfscan: [^o]|RDB CHANGED|ran \(|no IDERDB END' \
    "$SESS/$SIDE.result" | head -10
  rc=1
fi
echo "total: $(( $(date +%s) - t0 )) s"
exit $rc
