# Amiberry used by scripts/amiberry-session. Overridden by the environment (AMIBERRY_BIN, AMIBERRY_CWD) and by the
# start options --amiberry / --cwd. Shell syntax; $HOME is expanded.
#
# AMIBERRY_BIN: the amiberry executable.
AMIBERRY_BIN="$HOME/dev/tools/amiberry/build/amiberry"
# AMIBERRY_CWD: working directory Amiberry is started from (it looks for its data/ there). Empty = the parent of the
# binary's directory, e.g. ~/dev/tools/amiberry for ~/dev/tools/amiberry/build/amiberry.
AMIBERRY_CWD=""
