# Settings read by scripts/vamigaweb-session. Overridden by environment variables of the same names, and the URL by
# start --url. Shell-like syntax (KEY="value"); $HOME is expanded.
#
# VAMIGAWEB_URL: the vAmigaWeb page to drive (the live site, the one the README link opens).
VAMIGAWEB_URL="https://vamigaweb.github.io/"
# PLAYWRIGHT_BROWSERS_PATH: where Playwright keeps its Chromium. Empty = Playwright's default (~/.cache/ms-playwright).
PLAYWRIGHT_BROWSERS_PATH=""
