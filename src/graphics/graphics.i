; src/graphics/graphics.i — OCS display registers + M4 constants.
; IMPLEMENTATION track ("clean"): Amiga Hardware Reference Manual + AutoDocs (public). NO ROM reading.
; CUSTOM is defined in exec.i (included BEFORE this file). A copper MOVE targets a custom OFFSET (reg-CUSTOM).

; --- display registers (absolute addresses; HRM) ---
COP1LC   EQU CUSTOM+$080      ; Copper list 1 pointer (longword; reloaded by the hardware at every VBlank)
COPJMP1  EQU CUSTOM+$088      ; strobe: (re)starts the Copper on COP1LC (write strobe, value ignored)
COP2LC   EQU CUSTOM+$084      ; Copper list 2 pointer (copinit jumps to it through a MOVE COPJMP2)
COPJMP2  EQU CUSTOM+$08A
DIWSTRT  EQU CUSTOM+$08E      ; display window start (top-left corner)
DIWSTOP  EQU CUSTOM+$090      ; display window stop  (bottom-right corner)
DDFSTRT  EQU CUSTOM+$092      ; display data fetch start
DDFSTOP  EQU CUSTOM+$094      ; display data fetch stop
BPLCON0  EQU CUSTOM+$100      ; bitplane control; bits 14-12 = BPU (number of bitplanes); 0 = COLOR00 background only
BPLCON1  EQU CUSTOM+$102      ; fine scroll (0 = no shift)
BPLCON2  EQU CUSTOM+$104      ; sprite / playfield priorities
GFX_BPLCON2 EQU $0024         ; PF2P = PF1P = 4: all sprites in front of the playfields
BPL1MOD  EQU CUSTOM+$108      ; odd bitplane modulo (planes 1,3,5; 0 = contiguous planes)
BPL2MOD  EQU CUSTOM+$10A      ; even bitplane modulo (planes 2,4,6; 0 = contiguous planes)
BPL1PTH  EQU CUSTOM+$0E0      ; bitplane 1 pointer, HIGH word; BPLxPTH = BPL1PTH + (x-1)*4 (generated at runtime)
BPL1PTL  EQU CUSTOM+$0E2      ; bitplane 1 pointer, LOW word
COLOR01  EQU CUSTOM+$182      ; colour of pixel "1" (1st bitplane); COLORxx = COLOR00 + xx*2

; --- DMACON bits (dmabits.i) ---
DMAF_SETCLR EQU $8000         ; 1 = sets the bits to 1; 0 = clears them to 0
DMAF_COPPER EQU $0080         ; Copper DMA channel
DMAF_RASTER EQU $0100         ; bitplane DMA channel (fetches pixel data from chip RAM)
DMAF_MASTER EQU $0200         ; master DMA (required for ANY DMA channel to work)
DMAF_BLITTER EQU $0040        ; blitter DMA channel

; --- display init values (HRM): PAL lores OVERSCAN 352x272 (fills the screen edge to edge for the boot screen) ---
; hstart=$71 (113), hstop=113+352=465=$1D1 (H8 forced to 1); vstart=$24 (36), vstop=36+272=308=$134 (V8=~V7).
GFX_DIWSTRT  EQU $2471        ; vstart=$24 (36), hstart=$71 (113)
GFX_DIWSTOP  EQU $34D1        ; vstop field $34 -> $134=308 (V8=~V7); hstop $D1 -> $1D1=465
GFX_DDFSTRT  EQU $0030        ; lores: (hstart-17)/2 = (113-17)/2 = 48
GFX_DDFSTOP  EQU $00D8        ; lores: DDFSTRT + 8*(words-1) = $30 + 8*21 = $D8 (22 words = 352 px)
; Proof colour: 12-bit green $0F0. NEVER written by the CPU (see C_RED/BLUE/CYAN/WHITE/FAIL) -> its
; presence on screen ⟺ the chipset display produces it. In M4b it is carried by COLOR01 (bitplane pixel).
GFX_PROOF_COLOR EQU $0F0       ; COLOR01: pixel "1" (M4b proof)
GFX_BG_COLOR    EQU $00F       ; COLOR00: blue background (M4b); the green then comes ONLY from the bitplane

; --- 320x256 bitplane (lores, standard display window); 1 plane in M4b/stripes, 5 planes for the boot screen ---
GFX_BPL_BYTES   EQU 40         ; bytes per row (320 px / 8)
GFX_BPL_ROWS    EQU 256
GFX_BPL_SIZE    EQU GFX_BPL_BYTES*GFX_BPL_ROWS   ; 10240 bytes (one plane)
GFX_STRIPE_WORD EQU $FF00      ; M4b fill pattern: 8 px "1" + 8 px "0" -> stripes (historical)

; --- Boot screen (kitten image "KickSlopStart", generated by src/graphics/mk_bootscreen.py) ---
; Overscan resolution 352x272 (must match WIDTH/HEIGHT in mk_bootscreen.py and GFX_DIWSTRT/DDF* above).
GFX_BOOT_DEPTH    EQU 5                         ; 5 bitplanes = 32 colours (OCS lores)
GFX_BOOT_NCOLORS  EQU 32
GFX_BOOT_W        EQU 352                       ; display width (overscan)
GFX_BOOT_H        EQU 272                       ; display height (overscan)
GFX_BOOT_BYTES    EQU GFX_BOOT_W/8              ; 44 bytes per row
GFX_BOOT_PLANE_SZ EQU GFX_BOOT_BYTES*GFX_BOOT_H ; 11968 bytes (one plane)
GFX_BOOT_PLANES_SZ EQU GFX_BOOT_PLANE_SZ*GFX_BOOT_DEPTH  ; 59840 bytes (5 contiguous planes in chip RAM)
; BOOTSCR_ONE_PLANE=1 (RED): gfx_display_init sets bm_Depth=1 (plane 0 only) -> the ABI emits only one plane
; pointer + 2 colours -> the kitten image is destroyed (2 colours, wrong structure) -> the VISUAL proof (RMSE
; capture vs reference) fails, without affecting the boot (serial markers intact). Isolates multi-bitplane rendering.
BOOTSCR_ONE_PLANE EQU 0

; M4c2: the display is now GENERATED by the graphics.library ABI (MakeVPort/MrgCop/LoadView) from the
; View/ViewPort/BitMap/ColorMap structures — the hard-coded copper template of M4a/M4b is REMOVED. The proof
; "GREEN=stripes" holds by ELIMINATION: no other path draws the stripes any more. The M4A_NO_COPPER and
; M4B_NO_BITPLANE gates (which gated that template) are therefore REMOVED.
GFX_DMA_ON    EQU (DMAF_SETCLR|DMAF_MASTER|DMAF_COPPER|DMAF_RASTER|DMAF_SPRITE|DMAF_BLITTER)  ; enabled by LoadView
GFX_HIRES_BIT EQU $8000        ; BPLCON0 bit 15 (HIRES), set if vp_Modes has the HIRES bit ($8000)
GFX_COLOR_BIT EQU $0200        ; BPLCON0 bit 9 (composite COLOR); generated BPLCON0 = (depth<<12) | GFX_COLOR_BIT
; M4C2_NO_MRGCOP=1 (RED M4c2): MrgCop does NOT merge the vp_DspIns fragments -> v_LOFCprList contains only
; the final WAIT -> LoadView installs an empty list -> COLOR00 keeps the CPU white -> WHITE screen, no stripes.
; Proves that copper list generation by the ABI is load-bearing. Default 0 (inert).
M4C2_NO_MRGCOP EQU 0

