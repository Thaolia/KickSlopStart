; --- Sizes of the generated copper lists (chip RAM) ---
; MakeVPort is generic: DIW/DDF (4) + BPLCON0/1/2/BPL1MOD/BPL2MOD (5) + depth*2 (plane pointers) + Count
; (colours) MOVEs. Sized for this project's worst case (6 planes + 32 colours = 53 MOVEs = 106 words);
; MrgCop copies the whole fragment -> the zeroed remainder (MEMF_CLEAR) = inert MOVEs to BLTDDAT, harmless.
GFX_UCOPMAX    EQU 64             ; user instructions (vp_UCopIns) kept in a fragment
GFX_FRAG_WORDS EQU 106+GFX_UCOPMAX*2+2 ; + a WAIT for passing line 255
; struct UCopList / CopList / CopIns (graphics/copper.h)
ucl_FirstCopList EQU 4
ucl_CopList  EQU 8
UCL_SIZEOF   EQU 12
cl_Next      EQU 0
cl_CopIns    EQU 12
cl_CopPtr    EQU 16
cl_Count     EQU 28
cl_MaxCount  EQU 30
CL_SIZEOF    EQU 34
ci_OpCode    EQU 0               ; COPPER_MOVE 0, COPPER_WAIT 1
ci_Word1     EQU 2               ; DestAddr / VWaitPos
ci_Word2     EQU 4               ; DestData / HWaitPos
CI_SIZEOF    EQU 6
GFX_FRAG_SIZE  EQU GFX_FRAG_WORDS*2
GFX_SPRCOP_SIZE EQU 8*2*4            ; SPR0PTH/L..SPR7PTH/L: 16 MOVEs added by MrgCop
GFX_MASTER_SIZE EQU GFX_FRAG_SIZE+GFX_SPRCOP_SIZE+4   ; + final WAIT added by MrgCop

; --- Layout of the structure block AllocMem'd by gfx_display_init ---
GFX_O_VIEW     EQU 0
GFX_O_VP       EQU 20         ; after View (v_SIZEOF 18, aligned even)
GFX_O_RASINFO  EQU 60         ; after ViewPort (vp_SIZEOF 40)
GFX_O_BITMAP   EQU 72         ; after RasInfo (ri_SIZEOF 12)
GFX_O_COLORMAP EQU 112        ; after BitMap (bm_SIZEOF 40)
GFX_O_COLORTAB EQU 120        ; after ColorMap (8)
GFX_STRUCT_SIZE EQU GFX_O_COLORTAB+GFX_BOOT_NCOLORS*2  ; 184: 32-colour ColorTable (boot screen)

; M4c1: graphics.library as a resident module. M4C1_WRONG_TYPE=1 (RED): the ROMTag's RT_TYPE = NT_DEVICE instead
; of NT_LIBRARY -> the AUTOINIT path routes GfxBase to DeviceList (not LibList) -> FindName(LibList)
; fails -> "M4C1 GFX LIB OK" absent. Isolates the NT_LIBRARY->LibList routing branch (new: only
; NT_DEVICE had been exercised so far). Default 0 (inert).
M4C1_WRONG_TYPE EQU 0
