# Build artefacts
/build/
__pycache__/
*.pyc
*.o
*.obj

# Orchestration scratch (superpowers ledgers) and local assistant configuration
/.superpowers/
# .claude/: only the scoped rules and the amiberry skill are shared
/.claude/*
!/.claude/rules/
!/.claude/skills/
/.claude/skills/*
!/.claude/skills/amiberry/
# Personal assistant preferences
/CLAUDE.local.md

# Proprietary Kickstart ROM — NEVER commit or distribute.
# Each user provides their own copy in assets/ (see README).
/assets/kick34005.A500
/assets/*.rom
/assets/*.bin
# Test ADFs — regenerable (tests/mk_boot_adf.sh, xdftool); no binaries in the repository.
/assets/*.adf

# AROS: READ-ONLY reference (APL, never copied into src/), untracked partial clone
third_party/aros/
/assets/test_adf/
