# Makefile — builds the ROM images
#
#   kick  : main ROM (exec coldstart, M2+) — default target.
#           chain: vasm -Fvobj (one object per module) -> vlink -> mkrom -> romtool.
#   hello : M0 hello-ROM (green screen) — smoke test, single vasm -Fbin file.

VASM    ?= vasmm68k_mot
VLINK   ?= vlink
PYTHON  ?= python3
ROMTOOL ?= romtool
# VASMDEF: defines passed to vasm (empty = dev ROM). `make kick-prod` sets -DPROD=1 -> production variant
# (takes the dev harness out of the boot path; see src/exec/exec.i). No source edit required.
VASMDEF ?=

BUILD   := build
MKROM   := src/rom/mkrom.py

# --- main ROM: exec modules linked by vlink ---
EXEC_DIR  := src/exec
EXEC_INC  := $(EXEC_DIR)/exec.i
LDSCRIPT  := $(EXEC_DIR)/kick.ld
# LOAD-BEARING ORDER: boot.o FIRST -> its CODE carries the header at $FC0000.
EXEC_OBJ  := $(BUILD)/boot.o $(BUILD)/lists.o $(BUILD)/memory.o $(BUILD)/library.o $(BUILD)/rawdofmt.o $(BUILD)/tasks.o $(BUILD)/ports.o $(BUILD)/io.o $(BUILD)/ramlib.o $(BUILD)/interrupts.o $(BUILD)/resident.o $(BUILD)/libinit.o $(BUILD)/cia.o $(BUILD)/misc.o $(BUILD)/timer.o $(BUILD)/trackdisk.o $(BUILD)/strap.o $(BUILD)/keyboard.o $(BUILD)/input.o $(BUILD)/console.o $(BUILD)/keymap.o $(BUILD)/keymapdata.o $(BUILD)/gameport.o $(BUILD)/expansion.o $(BUILD)/romboot.o $(BUILD)/mathffp.o $(BUILD)/diskres.o $(BUILD)/potgo.o $(BUILD)/kbddev.o $(BUILD)/audio.o $(BUILD)/semaphores.o $(BUILD)/execmisc.o
# --- graphics track (M4+): objects linked AFTER exec (boot.o stays first) ---
GFX_DIR   := src/graphics
GFX_INC   := $(GFX_DIR)/graphics.i
# bootscreen_data.o: OCS palette + incbin of the 5 bitplanes of the boot screen (generated by mk_bootscreen.py).
GFX_OBJ   := $(BUILD)/gfx.o $(BUILD)/graphics_lib.o $(BUILD)/draw.o $(BUILD)/regions.o $(BUILD)/layers.o $(BUILD)/bootscreen_data.o $(BUILD)/font8x8.o $(BUILD)/text.o $(BUILD)/gels.o $(BUILD)/area.o
# loadscreen.o: loading screen — gated demo. Linked ONLY when VASMDEF enables LOADSCREEN_DEMO,
# so that the default ROM stays free of dead code (byte-identical). `make VASMDEF=-DLOADSCREEN_DEMO=1 kick`.
ifneq (,$(findstring LOADSCREEN_DEMO,$(VASMDEF)))
GFX_OBJ   += $(BUILD)/loadscreen.o
endif
# --- intuition track (M5+): objects linked AFTER graphics ---
INT_DIR   := src/intuition
INT_INC   := $(INT_DIR)/intuition.i
INT_OBJ   := $(BUILD)/intuition_lib.o $(BUILD)/screens.o $(BUILD)/menus.o $(BUILD)/requester.o $(BUILD)/request.o $(BUILD)/pointer.o $(BUILD)/prefs.o $(BUILD)/gadgets.o $(BUILD)/sysreq.o $(BUILD)/alert.o
# --- dos track (M6+): objects linked AFTER intuition ---
DOS_DIR   := src/dos
DOS_INC   := $(DOS_DIR)/dos.i
# ofs.o: read-only OFS (D1) — relies on trackdisk CMD_READ (disk.i); includes exec.i + disk.i + ofs.i.
# loadseg.o: LoadSeg (D2) — loads a hunk executable from OFS + relocation; includes exec.i + ofs.i.
# process.o: Process + CreateProc + dos_sendpkt (D3); includes exec.i + dospkt.i.
# handler.o: DF0: file-handler process (D3b); includes exec.i + ofs.i + dospkt.i.
# conhandler.o: serial console handler process (E1); shell.o: interactive shell (E2). includes exec.i + dospkt.i.
DOS_OBJ   := $(BUILD)/dos_lib.o $(BUILD)/ofs.o $(BUILD)/ofswrite.o $(BUILD)/loadseg.o $(BUILD)/bcpl.o $(BUILD)/process.o $(BUILD)/handler.o $(BUILD)/conhandler.o $(BUILD)/conwin.o $(BUILD)/shell.o $(BUILD)/diskvalidator.o $(BUILD)/feeder.o $(BUILD)/workbench.o
KICK_ROM  := $(BUILD)/kick13.rom

# --- hello-ROM (M0 smoke test) ---
HELLO_SRC := src/rom/start.s
HELLO_ROM := $(BUILD)/kick13-hello.rom

.PHONY: all kick kick-prod hello verify clean

all: kick
kick: $(KICK_ROM)
hello: $(HELLO_ROM)

# kick-prod: PRODUCTION ROM (-DPROD=1) — takes the dev harness out of the boot path (see src/exec/exec.i).
# Objects kept in build/prod/ (the dev ROM build/*.o stays intact); final image build/kick13-prod.rom.
kick-prod:
	$(MAKE) BUILD=build/prod VASMDEF=-DPROD=1 KICK_ROM=build/kick13-prod.rom kick

$(BUILD):
	mkdir -p $(BUILD)

# One relocatable object (vobj) per exec module; depends on the shared include.
# -I src/dos: boot.s includes dospkt.i (D3 Process/packet constants for the proof scaffold).
$(BUILD)/%.o: $(EXEC_DIR)/%.s $(EXEC_INC) | $(BUILD)
	$(VASM) -Fvobj -m68000 $(VASMDEF) -I $(EXEC_DIR) -I $(DOS_DIR) -o $@ $<
# console.s also includes graphics.i + intuition.i (rendering in windows: RastPort, struct Window).
$(BUILD)/console.o: $(EXEC_DIR)/console.s $(EXEC_INC) $(GFX_DIR)/graphics.i $(INT_DIR)/intuition.i | $(BUILD)
	$(VASM) -Fvobj -m68000 $(VASMDEF) -I $(EXEC_DIR) -I $(GFX_DIR) -I $(INT_DIR) -o $@ $<
# trackdisk.s also includes disk.i (B2 disk registers).
$(BUILD)/trackdisk.o $(BUILD)/diskres.o: $(EXEC_DIR)/disk.i
# expansion.s includes expansion.i (ExpansionBase/ConfigDev/LVO): dependency wired for rebuilds.
$(BUILD)/expansion.o $(BUILD)/romboot.o: $(EXEC_DIR)/expansion.i
# boot.s includes dospkt.i + dos.i (D3 proof scaffold, DeviceNode mount): dependencies wired.
$(BUILD)/boot.o: $(DOS_DIR)/dospkt.i $(DOS_DIR)/dos.i
# dos_lib.o includes dospkt.i (D3c: Open/Read/Close via packets): dependency wired.
$(BUILD)/dos_lib.o: $(DOS_DIR)/dospkt.i

# Graphics module(s) (src/graphics): include exec.i (ABI/LVO) + graphics.i (display registers).
$(BUILD)/%.o: $(GFX_DIR)/%.s $(EXEC_INC) $(GFX_INC) | $(BUILD)
	$(VASM) -Fvobj -m68000 $(VASMDEF) -I $(EXEC_DIR) -I $(GFX_DIR) -o $@ $<
# bootscreen_data.s incbins bootscreen.raw: dependency wired so a regeneration triggers a rebuild.
$(BUILD)/bootscreen_data.o: $(GFX_DIR)/bootscreen.raw
# loadscreen.o (loading screen) also includes ofs.i (src/dos, streaming) -> dedicated rule with -I src/dos.
$(BUILD)/loadscreen.o: $(GFX_DIR)/loadscreen.s $(EXEC_INC) $(GFX_INC) $(DOS_DIR)/ofs.i | $(BUILD)
	$(VASM) -Fvobj -m68000 $(VASMDEF) -I $(EXEC_DIR) -I $(GFX_DIR) -I $(DOS_DIR) -o $@ $<

# Intuition module(s) (src/intuition): include exec.i (ABI/LVO) + intuition.i (IntuitionBase layout) + graphics.i
# (drawing structures and graphics LVOs: screens and windows).
$(BUILD)/%.o: $(INT_DIR)/%.s $(EXEC_INC) $(INT_INC) $(GFX_INC) | $(BUILD)
	$(VASM) -Fvobj -m68000 $(VASMDEF) -I $(EXEC_DIR) -I $(INT_DIR) -I $(GFX_DIR) -o $@ $<

# Dos module(s) (src/dos): include exec.i (ABI/LVO/AllocMem) + dos.i (DosLibrary/RootNode/DosInfo layout, BPTR).
$(BUILD)/%.o: $(DOS_DIR)/%.s $(EXEC_INC) $(DOS_INC) | $(BUILD)
	$(VASM) -Fvobj -m68000 $(VASMDEF) -I $(EXEC_DIR) -I $(DOS_DIR) -o $@ $<
# workbench.o also includes intuition.i + graphics.i (backdrop window, icons) -> dedicated rule.
$(BUILD)/workbench.o: $(DOS_DIR)/workbench.s $(EXEC_INC) $(DOS_DIR)/dospkt.i $(INT_DIR)/intuition.i $(GFX_DIR)/graphics.i | $(BUILD)
	$(VASM) -Fvobj -m68000 $(VASMDEF) -I $(EXEC_DIR) -I $(DOS_DIR) -I $(INT_DIR) -I $(GFX_DIR) -o $@ $<
# ofs.o also includes disk.i (CMD_READ) + ofs.i (OFS constants): dependencies wired for rebuilds.
$(BUILD)/ofs.o: $(DOS_DIR)/ofs.i $(EXEC_DIR)/disk.i
$(BUILD)/diskvalidator.o: $(DOS_DIR)/ofs.i $(EXEC_DIR)/disk.i
# loadseg.o includes ofs.i (IOREQ/constants): dependency wired for rebuilds.
$(BUILD)/loadseg.o: $(DOS_DIR)/ofs.i
# process.o includes dospkt.i: dependency wired for rebuilds.
$(BUILD)/process.o: $(DOS_DIR)/dospkt.i
# handler.o includes ofs.i + dospkt.i: dependencies wired for rebuilds.
$(BUILD)/handler.o: $(DOS_DIR)/ofs.i $(DOS_DIR)/dospkt.i
# conhandler.o includes dospkt.i (E1); shell.o includes dospkt.i (E2): dependencies wired for rebuilds.
$(BUILD)/conhandler.o: $(DOS_DIR)/dospkt.i
$(BUILD)/shell.o: $(DOS_DIR)/dospkt.i

# Link at $FC0000 (script) -> raw binary; mkrom pads + footer/checksum.
$(BUILD)/kick.bin: $(EXEC_OBJ) $(GFX_OBJ) $(INT_OBJ) $(DOS_OBJ) $(LDSCRIPT)
	$(VLINK) -b rawbin1 -T $(LDSCRIPT) -o $@ $(EXEC_OBJ) $(GFX_OBJ) $(INT_OBJ) $(DOS_OBJ)
$(KICK_ROM): $(BUILD)/kick.bin $(MKROM)
	$(PYTHON) $(MKROM) --in $< --out $@ --size 256

$(BUILD)/hello.bin: $(HELLO_SRC) | $(BUILD)
	$(VASM) -Fbin -m68000 -o $@ $<
$(HELLO_ROM): $(BUILD)/hello.bin $(MKROM)
	$(PYTHON) $(MKROM) --in $< --out $@ --size 256

verify: $(KICK_ROM)
	@sz=$$(stat -c%s $(KICK_ROM)); \
	 if [ "$$sz" = "262144" ]; then echo "taille OK : 262144 o"; \
	 else echo "ECHEC taille : $$sz != 262144"; exit 1; fi
	@if command -v $(ROMTOOL) >/dev/null; then \
	   info=$$($(ROMTOOL) info $(KICK_ROM)); echo "$$info"; \
	   if echo "$$info" | grep -qE '^is_kick[[:space:]]+ok' \
	   && echo "$$info" | grep -qE '^chk_sum[[:space:]]+ok'; then \
	     echo "romtool OK : is_kick + chk_sum"; \
	   else echo "ECHEC romtool : is_kick/chk_sum != ok"; exit 1; fi; \
	 else echo "note : $(ROMTOOL) absent — gate romtool sautée"; fi

clean:
	rm -rf $(BUILD)
